--- !u!114 &1755255831
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1755255830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7147c2f52e561cf48a23e01d7642748d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eqoPanel: {fileID: 1505421599}
  verelPanel: {fileID: 1225722438}
  eqoNameText: {fileID: 388747648}
  eqoDialogueText: {fileID: 68012154}
  verelNameText: {fileID: 1295019491}
  verelDialogueText: {fileID: 815031357}
  eqo: {fileID: 759412146}
  verel: {fileID: 10209112}
  dialogues:
  - speaker: VERREL
    sentence: Kerja bagus, Eqo. Area pertama sudah jauh lebih bersih.
  - speaker: EQO
    sentence: Masih banyak sampah yang harus dibersihkan. Kota ini belum benar-benar
      pulih.
  - speaker: VERREL
    sentence: Benar. Tapi kita mendapat laporan baru dari kompleks apartemen di sektor
      timur.
  - speaker: EQO
    sentence: Ada apa di sana?
  - speaker: VERREL
    sentence: Limbah yang menumpuk mulai menciptakan makhluk bernama MinMon.
  - speaker: EQO
    sentence: Jadi kali ini aku harus membersihkan sampah sekaligus menghadapi monster?
  - speaker: VERREL
    sentence: Ya. Tenang saja, aku sudah menyiapkan pistol air untukmu. Senjata itu
      cukup efektif melawan MinMon.
  - speaker: EQO
    sentence: Baik. Aku akan memastikan area itu kembali aman.
  - speaker: VERREL
    sentence: Hati-hati. Jangan hanya fokus pada monster. Misi utamamu tetap membersihkan
      lingkungan.
  typingSpeed: 0.03
  nextScene: level2
